{
  "short_name": "UFoundIt",
  "name": "UFoundIt - Find Your Campus",
  "description": "Create campus challenges with shared photos.",
  "icons": [
    {
      "src": "logo192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any maskable"
    },
    {
      "src": "logo512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any maskable"
    }
  ],
  "start_url": "/home",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#0f2f78",
  "background_color": "#f4f5f7",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "images",
          "accept": ["image/*"]
        }
      ]
    }
  }
}
